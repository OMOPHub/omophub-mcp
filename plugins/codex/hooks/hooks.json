{
  "hooks": {
    "UserPromptSubmit": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/check-prompt.mjs\""
          }
        ]
      }
    ],
    "PostToolUse": [
      {
        "matcher": "^mcp__omophub__get_hierarchy$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/check-hierarchy-page.mjs\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/check-coding.mjs\""
          }
        ],
        "matcher": "^mcp__omophub__fhir_resolve(_codeable_concept)?$"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/check-search-result.mjs\""
          }
        ],
        "matcher": "^mcp__omophub__search_concepts$"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/check-mapping-result.mjs\""
          }
        ],
        "matcher": "^mcp__omophub__map_concept$"
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/check-hierarchy-reply.mjs\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/check-coding.mjs\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/check-search-result.mjs\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/check-mapping-result.mjs\""
          }
        ]
      }
    ],
    "PreToolUse": [
      {
        "matcher": "^mcp__omophub__get_hierarchy$",
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/check-hierarchy-read.mjs\""
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/check-coding.mjs\""
          }
        ],
        "matcher": "^mcp__omophub__"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/check-search-result.mjs\""
          }
        ],
        "matcher": "^mcp__omophub__(?:search_concepts|get_concept|semantic_search)$"
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "node \"${PLUGIN_ROOT}/hooks/check-mapping-result.mjs\""
          }
        ],
        "matcher": "^mcp__omophub__map_concept$"
      }
    ]
  }
}
