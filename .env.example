# Local stdio only. HTTP clients provide an individual bearer credential on every request.
OMOPHUB_API_KEY=

# Optional — Override API base URL (default: https://api.omophub.com/v1)
# OMOPHUB_BASE_URL=https://api.omophub.com/v1

# Optional — Opt out of analytics headers (default: false)
# OMOPHUB_ANALYTICS_OPTOUT=true

# Optional — Append a deployment identifier to User-Agent (default: none)
# OMOPHUB_USER_AGENT_SUFFIX=omophub-hosted/1

# Optional — Log level: debug, info, warn, error (default: info)
# OMOPHUB_LOG_LEVEL=info

# Optional — Enable health endpoint on this port (disabled by default)
# HEALTH_PORT=8080

# Local HTTP binds to loopback. For a container behind a proxy, set the bind
# address explicitly and allow the exact external host[:port] used by clients.
# MCP_HOST=127.0.0.1
# MCP_ALLOWED_HOSTS=mcp.example.test
# MCP_ALLOWED_ORIGINS=https://client.example.test

# Hosted HTTP OAuth. The private vocabulary API checks the app grant and account tier.
# Configure the issuer and MCP resource with one of the two API credential modes.
# OMOPHUB_OAUTH_ISSUER=https://dashboard.example.test/api/auth
# OMOPHUB_OAUTH_ISSUER_INTERNAL=http://127.0.0.1:3001/api/auth
# OMOPHUB_OAUTH_MCP_RESOURCE=https://mcp.example.test/mcp
# Private service mode (production)
# OMOPHUB_MCP_API_INTERNAL=https://private-api.example.test/v1
# OMOPHUB_MCP_SERVICE_TOKEN=

# Alternative token-exchange mode (configure in place of private service mode)
# OMOPHUB_OAUTH_API_RESOURCE=https://api.example.test/v1
# OMOPHUB_OAUTH_CLIENT_ID=
# OMOPHUB_OAUTH_CLIENT_SECRET=
